[Unit]
Description=Universal Agent end-of-day golden-nuggets demo judge (Component D — deploy-independent once-daily timer, SECRET-BEARING: Anthropic/ZAI key for the critical-eye judge + build_demo.py land)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ua
Group=ua
WorkingDirectory=/opt/universal_agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/universal_agent/src
Environment=PYDANTIC_DISABLE_PLUGINS=logfire-plugin
# LOAD BEARING: the build path shells out to the `claude` CLI by bare name
# (demo_factory _launch.probe_live / goal_argv). The claude binary lives ONLY at
# /home/ua/.local/bin/claude, which is NOT on systemd's default PATH
# (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin). Without this the
# auth probe raises FileNotFoundError -> auth_label="invalid" -> goal_build
# silently DRYRUNs -> build_demo lands a template stub -> verify FAIL -> exit 3
# (every nightly build failed this way). Interactive /demo works because it runs
# in a login shell where ~/.local/bin is on PATH.
Environment=PATH=/home/ua/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets-bootstrap backstop (mirrors universal-agent-proactive-demo-build-sweep).
# LOAD BEARING: proactive_demo_nuggets_cron.main() calls
# initialize_runtime_secrets() and both the critical-eye LLM judge
# (csi_demo_triage_ranker._call_llm) and the build_demo.py land read the API key
# from os.environ. As a standalone oneshot it has no gateway parent to inherit
# keys from, so UA_DEPLOYMENT_PROFILE=vps must drive a strict Infisical
# production load. .env OVERRIDES these when present. GATED OFF by default:
# UA_PROACTIVE_DEMO_NUGGETS_ENABLED must be flipped on before this builds
# anything (the cron no-ops otherwise).
Environment=UA_DEPLOYMENT_PROFILE=vps
Environment=UA_INFISICAL_ENABLED=1
Environment=INFISICAL_ENVIRONMENT=production
EnvironmentFile=-/opt/universal_agent/.env
ExecStart=/opt/universal_agent/.venv/bin/python -m universal_agent.scripts.proactive_demo_nuggets_cron
# Memory. CORRECTED 2026-08-02 after reading the kernel memcg records; the
# previous comment here (and #1579's premise) was wrong on two counts.
#
# 1. The 2026-08-01 run did NOT die of memory. Its main python EXITED 0
#    (ExecMainCode=1/ExecMainStatus=0) at 06:36:47 having completed every phase
#    including the swipe. systemd recorded result=timeout only because leftover
#    `claude` grandchildren were still in the cgroup at teardown -- fixed at the
#    source by #1587 (_default_build_runner now reaps its process group).
# 2. "peaked at exactly 1.0G" is a CLAMP reading, not a demand reading: the run
#    was pinned at the then-current MemoryMax=1G and spilled 1.16G to swap.
#    #1579 landed at 19:27 UTC on 08-01, ~13h AFTER that run -- so nothing about
#    that night was measured under these limits. (Independent proof: its
#    stop-sigterm timed out at exactly 90s = DefaultTimeoutStopSec, not the
#    TimeoutStopSec=300 below.)
#
# Real demand, from the three CONSTRAINT_MEMCG oom-kills in /var/log/kern.log
# (2026-07-20, 07-22, 07-27), every one pinned at limit=1048576kB:
#   anon resident ~1.0G + swap 5.08G / 4.96G / 5.63G  =>  ~6.0-6.6G of anon demand
# and even the lightest surviving night (08-01) wanted 1.0G + 1.16G = 2.16G.
#
# MemoryHigh REMOVED (was 2G). memory.high does not kill -- it forces direct
# reclaim and adds an explicit userspace sleep penalty per event. At 2G it binds
# on EVERY observed night (the lightest wanted 2.16G), so it buys nothing but a
# slow run, and it converts a loud result=oom-kill into a quiet result=timeout --
# the exact diagnostic confusion that cost us a day here. There is also nothing
# to protect: box-wide /proc/pressure/memory reads 0.00/0.00/0.00 with ~11.7G
# available on a 16G host. This job is already bounded end-to-end by wall clock
# (3600s/build, TimeoutStartSec below), so throttling it is pure downside.
#
# MemoryMax stays 3G DELIBERATELY, as fault isolation rather than as a fitted
# limit. With #1587 reaping orphaned build trees, expected demand is the ~2.16G
# baseline, not the 6G seen when a timed-out build's `claude` tree stayed charged
# to the cgroup for the rest of the run. If the ExecStopPost postmortem below
# shows a post-#1587 run still pushing past 3G, raise this to 6G -- do not guess.
MemoryMax=3G
# Capture the cgroup evidence that a Type=oneshot otherwise destroys on exit:
# memory.events (the high/max/oom counters), memory.pressure, and any leftover
# processes still charged at teardown. ExecStopPost runs inside the unit's
# cgroup while it still exists, and runs on abnormal exits too, so this records
# oom-kill and timeout runs as well. Leading `-` so a failure here can never
# change the unit's result. Grep the journal for CGPM.
ExecStopPost=-/opt/universal_agent/scripts/nuggets_cgroup_postmortem.sh
# One SQL scan + one bounded LLM judge call + up to nuggets_max (default 3) full
# demo_factory land builds + the end-of-day zero-backlog swipe that runs AFTER
# the builds. Cap MUST exceed
# 3 * UA_PROACTIVE_DEMO_NUGGETS_BUILD_TIMEOUT_SECONDS (default 3600) + slack, or a
# 3-build night gets killed mid-build and the swipe (which runs last) never fires,
# leaving the backlog un-reset. 3*3600 + 1200 slack = 12000.
#
# Measured 2026-07-26..08-01: wall clock is build time and nothing else. Builds
# run SEQUENTIALLY, and on 08-01 the three builds summed to 105m47s inside a
# 105m56s run -- 99.86% of wall. 1-build nights are 24-45m; 3-build nights are
# 94-138m. Worst observed is 137m23s, well inside this cap, so 12000 is right
# and is not the binding constraint.
#
# NB two comments here used to be wrong: builds do NOT run on Opus (--model-tier
# defaults to `auto`, which right-sizes the generic class down to claude-sonnet-5),
# and `--video` in the build argv is a DEPRECATED NO-OP (build_demo.py never reads
# a.video; the explainer render lives in land_demo.py after final_pass).
TimeoutStartSec=12000
# Stop grace: on 2026-08-01 the claude children ignored SIGTERM through both
# default 90s kill phases, painting the memory death as result=timeout.
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
